# -> /etc/hausbroker/bridge.env (setup.sh legt sie an, Rechte 600)
MQTT_HOST=localhost
MQTT_PORT=1883
MQTT_USER=bridge
MQTT_PASS=HIER_PASSWORT
# Web-Adresse von heizung.ts (Val Town), dieselbe wie ASCHE.URL im Dashboard
HEIZUNG_URL=https://steffgrosjean--6a065972ca1011f18c2a1607ee4eb77e.web.val.run
# Pumpwerk-Ereignisse an Val Town (pumpwerk.ts). Beide muessen gesetzt sein, sonst ist die Weitergabe aus.
# PUMPWERK_TOKEN = dasselbe Passwort wie die Umgebungsvariable PUMPWERK_TOKEN im Val (z. B. `openssl rand -hex 24`)
PUMPWERK_URL=https://steffgrosjean--b64bf86edc6c11f186431607ee4eb77e.web.val.run
PUMPWERK_TOKEN=
INTERVALL_S=300
MAX_ALTER_MIN=120
