[Unit]
Description=HausBroker-Weboberflaeche (Live-Ansicht, http://hausbroker.local:8080/)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=hausbroker
ExecStart=/usr/bin/python3 -m http.server 8080 --bind 0.0.0.0 --directory /opt/hausbroker/web
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
